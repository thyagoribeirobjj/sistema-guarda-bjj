rules_version = '2';

// Who can read and change what. tests/rules.test.js checks every line of this file.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validSettings() {
      let data = request.resource.data;
      return data.keys().hasOnly(['email', 'name', 'language', 'theme', 'belt', 'seenWeek', 'favorites', 'progress', 'lesson', 'updatedAt'])
        && data.email == request.auth.token.email
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('belt' in data) || data.belt in ['', 'white', 'blue', 'purple', 'brown', 'black'])
        && (!('seenWeek' in data) || (data.seenWeek is string && data.seenWeek.size() <= 100))
        && data.language in ['pt', 'en']
        && data.theme in ['', 'light', 'dark', 'orange', 'gold', 'royal', 'emerald']
        && data.favorites is list && data.favorites.size() <= 500
        && (!('progress' in data) || (data.progress is map && data.progress.size() <= 1000))
        && (!('lesson' in data) || (data.lesson is map && data.lesson.keys().hasOnly(['mod', 'dur', 'items', 'game'])
          && (!('items' in data.lesson) || (data.lesson.items is list && data.lesson.items.size() <= 200))))
        && data.updatedAt == request.time;
    }
    // Notes are saved one technique at a time: each save names the note it changes (changed), and only that
    // note may differ from what was stored. A note is short text.
    function validNotes() {
      let data = request.resource.data;
      return data.keys().hasOnly(['notes', 'changed', 'updatedAt'])
        && data.notes is map && data.notes.size() <= 500
        && onlyNamedNoteChanged(data, resource == null ? {} : resource.data.notes)
        && data.updatedAt == request.time;
    }
    function onlyNamedNoteChanged(data, before) {
      let changed = data.notes.diff(before).affectedKeys();
      return changed.size() == 0
        || (data.changed is string && changed.hasOnly([data.changed])
          && (!(data.changed in data.notes) || (data.notes[data.changed] is string && data.notes[data.changed].size() <= 2000)));
    }

    // What the whole site shows: the week (site/week), past weeks (site/weeks), each move's video and
    // diagram flag (site/media), and settings such as the translator's address (site/config).
    // Everyone reads, admins write.
    match /site/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // One diagram per move, as a small image stored in the document. Everyone reads, admins write.
    match /diagrams/{technique} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['image', 'updatedBy', 'updatedAt'])
        && request.resource.data.image is string
        && request.resource.data.image.size() < 900000
        && request.resource.data.image.matches('data:image/(webp|png|jpeg);base64,[A-Za-z0-9+/=]+');
    }

    // One document per admin, named by their email. Added by hand in the Firebase console.
    match /admins/{email} {
      allow read: if signedIn() && email == request.auth.token.email.lower();
    }

    // Each person's name, language, theme, belt, the class they last looked at, favorites, progress and lesson plan. Only they can change them;
    // coaches (admins) can see them, to follow their students.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSettings();
    }

    // A person's notes on techniques. Only they can see them: not even coaches.
    // They can be started only while the person's settings exist, so a device still signed in after "Delete my data"
    // can't start them again. Ordinary saves are updates and cost no extra read.
    match /users/{uid}/private/notes {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validNotes() && exists(/databases/$(database)/documents/users/$(uid));
      allow update: if isOwner(uid) && validNotes();
    }
  }
}
