# Sistema Guarda BJJ — database configuration
#
# The app reads its configuration from ONE string: DATABASE_URL.
# Today the site is static-only, so the "database" is the JSON files in
# data/ (data/users.json maps email -> user configuration). No backend
# runs yet, and this file is documentation for the move that comes next.
#
# When a backend is added, point DATABASE_URL at a real database and the
# same mapping (email -> configuration) moves there with no change to the
# data model: users, their language/level/my-system techniques and
# progress, plus the weekly content in data/week.json.

# Current (file-based, demo): a SQLite file next to the data folder.
DATABASE_URL=sqlite:./data/app.db

# Later — swap the value, keep the same mechanism:
# DATABASE_URL=postgres://user:password@host:5432/sistema_guarda
# DATABASE_URL=sql://user:password@host:5432/sistema_guarda
# DATABASE_URL=spanner://projects/my-project/instances/main/databases/sistema_guarda
